# Public
NEXT_PUBLIC_CAL_LINK=                # e.g. leadstrategus/strategy-call: embeds Cal.com on /book
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # Cloudflare Turnstile (optional)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true   # set to false at launch to hide the dashed placeholder underlines

# Server: incoming leads (setup and DNS records in docs/LEADS.md)
RESEND_API_KEY=                      # re_... from Resend; leads are emailed through it
LEADS_FROM=                          # e.g. LeadStrategus Website <leads@leadstrategus.com> (domain verified in Resend)
LEADS_TO=                            # optional; defaults to kingshuk@leadstrategus.com
CONTACT_WEBHOOK_URL=                 # Google Sheet backup: Apps Script web app URL with ?token=...

# Server — integrations (all optional)
TURNSTILE_SECRET_KEY=
