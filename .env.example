# Public
NEXT_PUBLIC_CAL_LINK=                # e.g. leadstrategus/strategy-call: embeds Cal.com on /book
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # Cloudflare Turnstile (optional)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true   # set to false at launch to hide the dashed placeholder underlines

# Server: incoming leads (setup in docs/LEADS.md)
CONTACT_WEBHOOK_URL=                 # Apps Script web app URL with ?token=...; it saves the row and emails the lead

# Server — integrations (all optional)
TURNSTILE_SECRET_KEY=
